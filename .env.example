# Database (matches compose.yaml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expense-app
DB_USERNAME=mateo-local
DB_PASSWORD=secret

# Spring AI
OPENAI_API_KEY=your_api_key

# Keycloak admin (compose.yaml)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak issuer the API validates JWTs against (optional, has default)
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/expense-bot

# Observability (optional, has default)
OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Keycloak Google identity provider (required by compose.yaml)
GOOGLE_CLIENT_ID=id
GOOGLE_CLIENT_SECRET=secret

# Telegram: webhook (prod) or polling (dev)
# Token from BotFather; required in both modes (polling and sending replies)
TELEGRAM_MODE=webhook
TELEGRAM_BOT_TOKEN=
# Webhook mode only: the app fails closed if the secret is empty
# (1-256 chars, A-Z a-z 0-9 _ -)
TELEGRAM_WEBHOOK_SECRET=
# Webhook mode only: public HTTPS base URL of this app (the endpoint path is appended)
TELEGRAM_WEBHOOK_URL=